# Copy to .env and fill in. .env is gitignored; this file is not.

# --- xAI, for the X adapter (x_search) ------------------------------
# https://console.x.ai  --  about $0.012 per call at grok-4.3.
XAI_API_KEY=

# --- RYO platform ----------------------------------------------------
# The hackathon issues an MCP credential (ryo_mcp_*). The REST base URL
# is published separately in the builder guide.
# The MCP endpoint. Get this from the builder guide or Discord.
RYO_MCP_URL=
RYO_MCP_KEY=
RYO_MCP_KEY_ID=
RYO_MCP_KEY_LABEL=
RYO_MCP_KEY_EXPIRES_AT=
RYO_MCP_RATE_PER_MINUTE=

RYO_API_BASE=
RYO_API_KEY=
