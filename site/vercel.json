{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ],
  "functions": {
    "api/exit_liquidity.py": {
      "maxDuration": 30
    },
    "api/workbench.py": {
      "maxDuration": 10
    },
    "api/tools/exit_liquidity/call.py": {
      "maxDuration": 30
    },
    "api/mcp.py": {
      "maxDuration": 30
    },
    "api/drill.py": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "tryhanko.vercel.app"
        }
      ],
      "destination": "https://tryhanko.xyz/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.tryhanko.xyz"
        }
      ],
      "destination": "https://tryhanko.xyz/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "tryhanko.vercel.app"
        }
      ],
      "destination": "https://tryhanko.xyz/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.tryhanko.xyz"
        }
      ],
      "destination": "https://tryhanko.xyz/:path*",
      "permanent": true
    }
  ]
}
